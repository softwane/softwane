 RowBox[{"{", " ", 
  RowBox[{"g0", " ", ",", " ", "g1", ",", " ", "g2"}], "}"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"greenFit0", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
  RowBox[{"[", 
   RowBox[{"All", ",", "2"}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"greenFit1", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
  RowBox[{"[", 
