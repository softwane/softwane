Cell["Holistic", "Subsection",ExpressionUUID->"1721e675-90c9-9745-b5d6-2daa59473305"],

Cell[CellGroupData[{

Cell["Prolog", "Subsubsection",ExpressionUUID->"116dcf88-395c-744f-ab8f-0610edeee946"],

Cell[TextData[{
 "It\[CloseCurlyQuote]s actually a ",
 StyleBox["much ",
  FontSlant->"Italic"],
 "better idea if we throw the ",
 StyleBox["whole ",
  FontSlant->"Italic"],
 "function at NonlinearModelFit so that it sees the pieces and can fit across \
same."
}], "Text",ExpressionUUID->"ad109f07-9a44-8d40-b8af-2c1e30048949"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"shiftQuad", "[", "dx_", "]"}], " ", ":=", " ", 
  RowBox[{"a", " ", "+", " ", 
   RowBox[{"b", " ", 
    RowBox[{"(", 
     RowBox[{"x", "-", "dx"}], ")"}]}], " ", "+", " ", 
   RowBox[{"c", "  ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", "dx"}], ")"}], " ", "^", "2"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shiftCubic", "[", "dx_", "]"}], " ", ":=", " ", 
  RowBox[{"a", " ", "+", " ", 
   RowBox[{"b", " ", 
    RowBox[{"(", 
     RowBox[{"x", "-", "dx"}], ")"}]}], " ", "+", " ", 
   RowBox[{"c", "  ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", "dx"}], ")"}], " ", "^", "2"}]}], " ", "+", "  ", 
   RowBox[{"d", "  ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", "dx"}], ")"}], " ", "^", "3"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shiftCubic2", "[", "dx_", "]"}], " ", ":=", " ", 
  RowBox[{"e", " ", "+", " ", 
   RowBox[{"f", " ", 
    RowBox[{"(", 
     RowBox[{"x", "-", "dx"}], ")"}]}], " ", "+", " ", 
   RowBox[{"g", "  ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", "dx"}], ")"}], " ", "^", "2"}]}], " ", "+", "  ", 
   RowBox[{"h", "  ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", "dx"}], ")"}], " ", "^", "3"}]}]}]}]}], "Input",
