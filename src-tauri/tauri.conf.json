{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Softwane",
  "version": "0.1.0",
  "identifier": "com.softwane.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/softwane-icon.svg", "icons/softwane-icon-macos.svg"]
  }
}
